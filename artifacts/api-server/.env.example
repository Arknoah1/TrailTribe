# ─── API Server environment variables ────────────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# In production, set these as real environment variables (not a .env file).

# ── Required ──────────────────────────────────────────────────────────────────

PORT=3001

# Clerk authentication keys (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/trailtribe

# Session secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Invite link base URL ───────────────────────────────────────────────────────
#
# TrailTribe builds family invite URLs from one of two env vars.
# Precedence (highest → lowest):
#
#   1. APP_BASE_URL           — use this in production on a custom domain.
#                               Set it to the full origin with no trailing slash,
#                               e.g. https://app.myteam.org
#                               The server logs the resolved value at startup so
#                               you can confirm it without sending a test invite.
#
#   2. FRONTEND_BASE_PATH     — sub-path when the frontend is not at the root,
#                               e.g. /trailtribe  (default).
#                               Combined with REPLIT_DEV_DOMAIN on Replit.
#
# Examples:
#   Production custom domain:   APP_BASE_URL=https://app.myteam.org
#   Replit dev (default):       REPLIT_DEV_DOMAIN is set automatically — no action needed.
#   Replit dev, custom path:    FRONTEND_BASE_PATH=/my-app

# APP_BASE_URL=https://app.myteam.org
# FRONTEND_BASE_PATH=/trailtribe

# ── Optional ──────────────────────────────────────────────────────────────────

# Resend API key for transactional email (https://resend.com)
# RESEND_API_KEY=re_...

# Twilio credentials for SMS notifications
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15550000000

# Object storage
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=...
# PRIVATE_OBJECT_DIR=private
# PUBLIC_OBJECT_SEARCH_PATHS=public
