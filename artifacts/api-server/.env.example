# ─── API Server environment variables ────────────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# In production, set these as real environment variables (not a .env file).

# ── Required ──────────────────────────────────────────────────────────────────

PORT=3001

# Clerk authentication keys (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/trailtribe

# Session secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Invite link base URL ───────────────────────────────────────────────────────
#
# TrailTeam builds family invite URLs from one of two env vars.
# Precedence (highest → lowest):
#
#   1. APP_BASE_URL           — use this in production on a custom domain.
#                               Set it to the full origin with no trailing slash,
#                               e.g. https://app.myteam.org
#                               The server logs the resolved value at startup so
#                               you can confirm it without sending a test invite.
#
#   2. FRONTEND_BASE_PATH     — sub-path when the frontend is not at the root,
#                               e.g. /trailtribe  (default).
#                               Combined with REPLIT_DEV_DOMAIN on Replit.
#
# Examples:
#   Production custom domain:   APP_BASE_URL=https://app.myteam.org
#   Replit dev (default):       REPLIT_DEV_DOMAIN is set automatically — no action needed.
#   Replit dev, custom path:    FRONTEND_BASE_PATH=/my-app

# APP_BASE_URL=https://app.myteam.org
# FRONTEND_BASE_PATH=/trailtribe

# ── Optional ──────────────────────────────────────────────────────────────────

# Resend API key for transactional email (https://resend.com)
# RESEND_API_KEY=re_...

# Transactional email sender. EMAIL_FROM must use the fixed display name.
# EMAIL_APPROVED_SENDER_MAILBOXES is a comma-separated allowlist of mailboxes
# already verified with the SMTP provider. If omitted, the built-in team
# mailboxes are used.
# EMAIL_FROM=Methow Cycling Team <coaches@methowcyclingteam.com>
# EMAIL_APPROVED_SENDER_MAILBOXES=coaches@methowcyclingteam.com

# Twilio credentials for SMS notifications
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15550000000

# Firebase Cloud Messaging (push notifications to the Android/iOS app).
# Base64-encode the full service account key JSON before setting this — a raw
# JSON value tends to get mangled by env var escaping around the multi-line
# private_key field. Generate the key from:
#   Firebase Console → Project settings → Service accounts → Generate new private key
# Then: base64 -w0 service-account-key.json   (macOS: base64 -i service-account-key.json)
# Push notifications are silently disabled (logged, not fatal) if this is unset.
# FIREBASE_SERVICE_ACCOUNT_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCi...

# Object storage
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=...
# PRIVATE_OBJECT_DIR=private
# PUBLIC_OBJECT_SEARCH_PATHS=public
