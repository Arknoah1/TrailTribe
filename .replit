modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 20671
externalPort = 3000

[[ports]]
localPort = 20672
externalPort = 3002

[[ports]]
localPort = 20673
externalPort = 4200

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk3", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "fontconfig", "freetype", "gdk-pixbuf", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "libdrm", "mesa", "alsa-lib", "libgbm", "libxkbcommon"]

[userenv]

[userenv.shared]
EMAIL_FROM = "TrailTeam <coaches@methowcyclingteam.com>"
SMTP_USER = "admin@methowcyclingteam.com"
APP_BASE_URL = "https://trailteam.app"
